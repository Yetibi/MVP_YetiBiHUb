{
  "crons": [
    {
      "path": "/api/cron/reintentar-intakes",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.yetibi.com"
        }
      ],
      "destination": "https://yetibi.com/:path*",
      "permanent": true
    }
  ]
}