# Copia este archivo como .env.local y llena los valores reales.
# Nunca subas .env.local al repositorio.
#
# Todas las que no llevan NEXT_PUBLIC_ son de servidor y no deben exponerse
# al cliente. En Vercel van en Settings → Environment Variables.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: SALTA las políticas RLS. Solo servidor, nunca en cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── URL base del sitio ──────────────────────────────────────────────────────
# La usa el cron para re-disparar /api/diagnostico. Sin ella cae a
# https://yetibi.com, lo que en previews apunta al sitio equivocado.
NEXT_PUBLIC_SITE_URL=

# ── n8n ─────────────────────────────────────────────────────────────────────
# Webhook de notificaciones internas al recibir un intake.
N8N_WEBHOOK_INTAKE_URL=
# Webhook de alerta cuando un intake supera 3 intentos de procesamiento.
N8N_WEBHOOK_ALERT_URL=

# ── Firma de enlaces de aprobación ──────────────────────────────────────────
# Secreto HMAC de los tokens de aprobar/ajustar (lib/approval-token.ts).
# Sin esta variable, esas rutas lanzan excepción. Cadena aleatoria larga.
APPROVAL_TOKEN_SECRET=

# ── Cron de Vercel ──────────────────────────────────────────────────────────
# Protege /api/cron/reintentar-intakes. OJO: hoy la guardia solo actúa si la
# variable existe, así que dejarla vacía deja la ruta abierta. Ponla siempre.
CRON_SECRET=

# ── Servicios externos ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
RESEND_API_KEY=
