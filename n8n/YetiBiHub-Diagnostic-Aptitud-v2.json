        "jsCode": "// /ajustar <diagnosticoId> <token> <indicacion...>\nconst texto = $input.item.json.message.text;\nconst sinComando = texto.replace(/^\\/ajustar\\s+/i, '');\nconst partes = sinComando.split(/\\s+/);\nconst diagnosticoId = partes[0] || '';\nconst token = partes[1] || '';\nconst indicacionAjuste = partes.slice(2).join(' ').trim();\n\nconst uuidValido = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(diagnosticoId);\n\nreturn [{\n  json: {\n    diagnosticoId,\n    token,\n    indicacionAjuste,\n    uuidValido,\n    chatId: $input.item.json.message.chat.id\n  }\n}];"
      },
