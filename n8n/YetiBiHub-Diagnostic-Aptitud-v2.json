        "jsCode": "// Reempaqueta la respuesta de /ajustar con la forma de la respuesta del\n// engine, para reusar \"Inicializar contador\" y todo el camino de revision.\n// OJO: usa el diagnosticoId y los tokens de la VERSION NUEVA.\nconst a = $('Llamar a /ajustar').item.json;\n\nreturn [{\n  json: {\n    ok: true,\n    diagnosticoId: a.diagnosticoId,\n    intakeId: a.intakeId,\n    patologia: a.patologia,\n    severidad: '(sin cambio — la patologia es inmutable)',\n    senalesSecundarias: [],\n    asunto: a.asunto,\n    cuerpoTexto: a.cuerpoTexto,\n    cuerpoHtml: a.cuerpoHtml,\n    correo: '',\n    respuestasLibres: {},\n    tokens: a.tokens\n  }\n}];"
