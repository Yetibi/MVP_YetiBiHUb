      "parameters": {
        "jsCode": "// Notificación interna del intake — etiquetas legibles (FIX 4)\nconst body = $input.item.json.body || {};\nconst l = body.legible || {};\n// parse_mode HTML: escapar los tres caracteres que lo rompen\nconst h = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\nconst mensajeTexto = `Nuevo intake — Evaluación de proceso\n\nNombre: ${h(body.nombre) || 'N/A'}\nCorreo: ${h(body.correo) || 'N/A'}\nSector: ${l.sector || body.sector || 'N/A'}\n\nProceso: ${h(body.proceso) || 'N/A'}\nQuién lo ejecuta: ${h(body.ejecucion) || 'N/A'}\n\nSeñal: ${l.senal || body.senal || 'N/A'}\nDato: ${l.dato || body.dato || 'N/A'}\nFrecuencia: ${l.frecuencia || body.frecuencia || 'N/A'} · Antigüedad: ${l.antiguedad || body.antiguedad || 'N/A'}\nFalla: ${l.falla || body.falla || 'N/A'}\n\nExpectativa de IA: ${h(body.expectativa_ia) || 'N/A'}`;\n\nreturn [{ json: { mensajeTexto, nombre: body.nombre || '', sectorLegible: l.sector || body.sector || '' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -176,
        160
      ],
