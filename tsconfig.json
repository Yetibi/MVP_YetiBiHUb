{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // scripts/ son utilidades de desarrollo: ninguna la invoca package.json y
  // varias estan marcadas -tmp. No se despliegan, pero el type-check de
  // `next build` las revisaba igual, asi que una de ellas -con un campo que
  // se renombro hace tiempo- bastaba para tumbar el despliegue de produccion.
  // Quedan en el repositorio; simplemente dejan de ser requisito para publicar.
  "exclude": ["node_modules", "scripts"]
}
